    isSystemMessage: 0
  - speaker: Iker
    text: "Aghh, otra vez lo mismo. No puedo lidiar con esto ahora mismo, mejor empiezo el d\xEDa."
    portrait: {fileID: 21300000, guid: 9c3c5795a533e2b49b1e39ee0c495ef2, type: 3}
    isSystemMessage: 0

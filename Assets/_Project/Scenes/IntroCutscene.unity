  dialogueLines:
  - speaker: "Mam\xE1"
    text: "Iker, \xBFc\xF3mo est\xE1s, hijo? Ha pasado mucho tiempo desde que escribiste o llamaste. Estoy muy preocupada, te extra\xF1o."
